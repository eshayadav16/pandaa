"use client";
import React, { createContext, useContext, useState } from "react";
import { ProductDetail } from "@/root/constants/types";

const PartNumberContext = createContext(null);

export function PartNumberProvider({ children }) {
  const [selectedPartNumber, setSelectedPartNumber] = useState<ProductDetail>();
  return (
    <PartNumberContext.Provider value={{ selectedPartNumber, setSelectedPartNumber }}>
      {children}
    </PartNumberContext.Provider>
  );
}

export function usePartNumber() {
  return useContext(PartNumberContext);
}

